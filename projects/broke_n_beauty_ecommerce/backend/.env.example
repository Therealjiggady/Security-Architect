# ===========================================
# BROKEN BEAUTY E-COMMERCE - ENVIRONMENT CONFIGURATION
# ===========================================

# Application Configuration
APP_NAME=Broken Beauty API
APP_VERSION=1.0.0
ENVIRONMENT=development
# Options: development, staging, production
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///./app.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Database Connection Pool (for production)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_RECYCLE=3600

# JWT Authentication Configuration  
JWT_SECRET=your-secret-key-change-in-production-make-it-very-long-and-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
FRONTEND_URL=http://localhost:5173
# Production examples:
# FRONTEND_URL=https://brokenbeauty.com,https://www.brokenbeauty.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here  
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email Configuration (Optional - for order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@brokenbeauty.com

# Security Configuration
SECURITY_COOKIE_SECURE=false
# Set to true in production (HTTPS only)
SECURITY_COOKIE_SAMESITE=lax
# Options: strict, lax, none

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# File Upload Configuration
MAX_FILE_SIZE=5242880
# 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Feature Flags
DEMO_MODE=true
MAINTENANCE_MODE=false
REGISTRATION_ENABLED=true
ADMIN_REGISTRATION_ENABLED=false

# External Services (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
REDIS_URL=redis://localhost:6379/0

# Production Deployment
PORT=8000
HOST=0.0.0.0
WORKERS=1
# Increase workers in production (e.g., 4)