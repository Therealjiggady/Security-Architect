# ===========================================
# BROKEN BEAUTY E-COMMERCE - FRONTEND CONFIGURATION  
# ===========================================

# Environment Configuration
VITE_ENVIRONMENT=development
# Options: development, staging, production
VITE_DEBUG=true

# API Configuration
VITE_API_URL=http://localhost:8000
# Production examples:
# VITE_API_URL=https://api.brokenbeauty.com
# VITE_API_URL=https://broke-beauty-api.onrender.com

# Stripe Payment Configuration (Public Keys Only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Production: pk_live_your_live_publishable_key_here

# App Metadata
VITE_APP_NAME=Broken Beauty
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Premium activewear and fitness clothing
VITE_SITE_URL=http://localhost:5173
# Production: https://brokenbeauty.com

# Feature Flags
VITE_DEMO_MODE=true
VITE_SHOW_DEMO_BANNER=true
VITE_REGISTRATION_ENABLED=true
VITE_CART_PERSISTENCE=true

# Analytics & Monitoring (Optional)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_HOTJAR_ID=XXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# SEO Configuration
VITE_SEO_TITLE=Broken Beauty - Premium Activewear
VITE_SEO_DESCRIPTION=Discover premium activewear and fitness clothing designed for performance and style
VITE_SEO_KEYWORDS=activewear,fitness,clothing,sportswear,leggings,sports bras
VITE_SEO_AUTHOR=Broken Beauty
VITE_SEO_IMAGE=https://brokenbeauty.com/og-image.jpg

# Social Media Links
VITE_SOCIAL_INSTAGRAM=https://instagram.com/brokenbeauty
VITE_SOCIAL_FACEBOOK=https://facebook.com/brokenbeauty
VITE_SOCIAL_TWITTER=https://twitter.com/brokenbeauty
VITE_SOCIAL_TIKTOK=https://tiktok.com/@brokenbeauty

# Contact Information
VITE_CONTACT_EMAIL=support@brokenbeauty.com
VITE_CONTACT_PHONE=+1-555-123-4567
VITE_CONTACT_ADDRESS=123 Fashion Ave, Style City, CA 90210

# Performance Configuration
VITE_API_TIMEOUT=10000
# API timeout in milliseconds
VITE_IMAGE_LAZY_LOADING=true
VITE_ENABLE_PWA=false

# Development Configuration  
VITE_MOCK_API=false
VITE_ENABLE_DEVTOOLS=true
VITE_SHOW_PERFORMANCE_METRICS=false